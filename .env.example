# Number that should RING (the USB phone's SIM places the call).
CALLEE=+918830077603

# Optional. Defaults to ~/Android/Sdk/platform-tools/adb or `adb` on PATH.
ADB_PATH=/home/asit/Android/Sdk/platform-tools/adb

# Milliseconds to wait after the calling phone goes off-hook before playing the prompt.
# Increase if the callee needs more time to pick up.
ANSWER_WAIT_MS=6000

# Where the prompt is spoken from.
#   bluetooth - this PC acts as the phone's headset, so the prompt is real
#               uplink audio and the reply is recorded from the downlink
#   pc        - this computer's speakers, picked up by the phone's mic
#   phone     - the calling phone's speaker (the callee will not hear it)
#   both      - pc and phone
PROMPT_PLAYBACK=bluetooth

# Bluetooth address of the calling phone. Run: npm run bt
PHONE_BT_MAC=

# How long to record the reply in bluetooth mode.
RECORD_MS=12000

# Max time to wait for the helper to finish (ms).
TIMEOUT_MS=90000

# ElevenLabs — spoken prompt only (TTS). Recordings are never uploaded.
# Paste the secret that starts with sk_ (Settings → API keys). Not the key ID.
# ELEVENLABS_API_KEY=sk_e48f3ba642c9a5324e823ea60a406779d05fe7533553f3ee
ELEVENLABS_API_KEY=sk_b32b85ae62c5584b137e681cb0a9c150b71de549756f5d29
# Optional voice ID from the ElevenLabs voice library.
# ELEVENLABS_VOICE_ID=1qEiC6qsybMkmnNdVMbK
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional. Default is Rachel.
ELEVENLABS_VOICE_English=tnSpp4vdxKPjI9w0GnoV
